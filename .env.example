# Keep real credentials in an untracked .env file or your host's secret manager.
GEMINI_API_KEY=replace-with-your-server-side-key
GEMINI_MODEL=gemini-3.8-flash
PORT=3000
API_RATE_LIMIT_REQUESTS=5
API_RATE_LIMIT_QUESTIONS=100
API_RATE_LIMIT_WINDOW_MS=60000
API_DAILY_REQUESTS=50
API_DAILY_QUESTIONS=500
# Set only when your host overwrites this header with the verified client IP.
# Supported values: x-real-ip, cf-connecting-ip, x-forwarded-for
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
